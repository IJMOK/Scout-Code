[Unit]
Description=Scout Code AI (llama.cpp llama-server)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
# One request at a time (-np 1) gets the full speed of the Pi. --cache-ram keeps
# recent teams' games in memory so their next request starts faster.
ExecStart=@SCOUT_DIR@/llama.cpp/build/bin/llama-server \
  --model @SCOUT_DIR@/models/current.gguf \
  --host 0.0.0.0 --port 8080 \
  --ctx-size 8192 -np 1 --threads 4 \
  --cache-ram 2048 \
  --no-webui \
  --api-key-file @SCOUT_DIR@/llm-key
Restart=always
RestartSec=3
Nice=-5

[Install]
WantedBy=multi-user.target
