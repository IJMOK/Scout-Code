[Unit]
Description=Scout Code portal (website)
After=network-online.target scout-llm.service
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@APP_DIR@
Environment=SCOUT_DATA_DIR=@SCOUT_DIR@/data
# Port 80 so the scouts just type scout.local
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=@SCOUT_DIR@/venv/bin/uvicorn server.app:create_app --factory --host 0.0.0.0 --port 80 --timeout-graceful-shutdown 3
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
